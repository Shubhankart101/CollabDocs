					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/comments/?document={{documentId}}",
							"host": ["{{baseUrl}}"],
							"path": ["comments", ""],
							"query": [
								{
									"key": "document",
									"value": "{{documentId}}"
