								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"document\": \"{{documentId}}\",\n  \"author\": \"{{userId}}\",\n  \"content\": \"Great writeup! Could you expand on the database indexing strategy?\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/comments/",
							"host": ["{{baseUrl}}"],
							"path": ["comments", ""]
