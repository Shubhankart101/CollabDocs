{
	"info": {
		"_postman_id": "c1f3b890-5a3d-4e9e-87a2-collabdocs-17",
		"name": "CollabDocs API",
		"description": "Postman Collection for CollabDocs RESTful API covering all 17 endpoints across Users, Workspaces, Documents, Comments, Tags, and Audit Logs.",
